          <mxGeometry x="100" y="90" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="alb" value="Application Load Balancer&#xa;Path-Based Routing:&#xa;/api/auth* -&gt; TG-Auth | /api/orders* -&gt; TG-Orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#14532D;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="80" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ecr" value="Amazon ECR Private Repositories&#xa;(Image Vulnerability Scanning on Push)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EA580C;strokeColor=#7C2D12;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="90" width="300" height="60" as="geometry" />
